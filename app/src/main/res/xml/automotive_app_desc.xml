<?xml version="1.0" encoding="utf-8"?>
<!--
  What AAAD tells Android Auto it can do.

  "template" is not a guess: AAAD implements an official androidx.car.app.CarAppService, and
  Nav2Contacts in the bundled catalog declares the same capability. "projection" belongs to the
  legacy full-screen SDK this app does not implement. Besides being inaccurate, declaring it made
  the Convert scanner suppress AAAD's safe side-by-side parked-copy action as though AAAD were a
  publisher-provided legacy projection app. See docs/aa-visibility.md.
-->
<automotiveApp>
    <uses name="template" />
</automotiveApp>
