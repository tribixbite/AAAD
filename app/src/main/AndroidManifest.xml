<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The camera feature/permission existed only for QR license transfer, which this
         standalone fork does not have. See docs/standalone.md. -->

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.DELETE_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shizuku's own runtime permission. Without it Shizuku.checkSelfPermission always denies,
         and the Play-attributed install path — the only one Android Auto honours — is
         unavailable. See docs/aa-visibility.md. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Request ability to query all packages (Android 11+) -->
    <!-- This ensures we can detect ALL installed apps without declaring each one -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <!-- Allow package installer intents -->
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="file" />
        </intent>

        <!-- Email app queries - Required for Android 11+ to see email apps like Gmail, Spark, etc. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="message/rfc822" />
        </intent>

        <!-- Declare specific packages we want to detect as installed (Android 11+) -->
        <!-- CarStream. Upstream v2.1 (this repo's source drop) had a typo here —
             "jaoloonda" — so CarStream was never detected as installed. Corrected to the
             real package name, per upstream v2.8.5 and its catalog. See
             docs/upstream-2.8.5-diff.md. -->
        <package android:name="maps.jaoolonda.android" />
        <!-- CarStream as its own publisher ships it (thekirankumar/carstream-android-auto).
             The id is disguised as a Google package; verified by reading the released APK. -->
        <package android:name="com.google.android.kk" />

        <!-- Multimedia apps -->
        <package android:name="me.aap.fermata.auto.dear.google.why" />

        <!-- Mirroring apps -->
        <!-- Screen2Auto as its publisher ships it (inceptive.ru); upstream renamed it. -->
        <package android:name="ru.inceptive.screentwoauto" />
        <package android:name="android.loandamaps.it" />
        <package android:name="maps.kiao2client.android" />
        <package android:name="maps.mobilejiohubclient.android" />
        <package android:name="maps.mobilejiohub.android" />

        <!-- Utility apps -->
        <package android:name="com.github.martoreto.aaremote" />
        <!-- The publisher (ns130291/widgets-for-auto) ships de.nsvb.android.auto.widget;
             upstream AAAD's catalog says de.nsvb.android.auto.w4a. Read from the released APK.
             Both are listed so an upstream-installed copy is still detected. -->
        <package android:name="de.nsvb.android.auto.widget" />
        <package android:name="de.nsvb.android.auto.w4a" />
        <package android:name="nl.frankkie.nav2contacts" />
        <package android:name="com.mqbcoding.stats" />
        <package android:name="com.aatorque.stats" />
        <package android:name="com.kododake.aabrowser" />

        <!-- Shizuku - Required for Android 11+ package visibility -->
        <package android:name="moe.shizuku.privileged.api" />

        <!-- Android Auto - Required for accessing developer settings -->
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:screenOrientation="portrait"
        android:theme="@style/Theme.AA_Apps_Downloader">

        <!-- New Launcher Activity -->
        <activity
            android:name=".LauncherActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:theme="@style/Theme.AA_Apps_Downloader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run setup -->
        <activity
            android:name=".OnboardingActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.AA_Apps_Downloader" />

        <!-- Diagnostics -->
        <activity
            android:name=".SupportActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:parentActivityName=".MainActivityNew"
            android:theme="@style/Theme.AA_Apps_Downloader" />

        <!-- Android Auto developer-settings walkthrough -->
        <activity
            android:name=".AndroidAutoSetupActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/android_auto_setup_title"
            android:parentActivityName=".MainActivityNew"
            android:theme="@style/Theme.AA_Apps_Downloader" />

        <!-- Find more apps on GitHub -->
        <activity
            android:name=".DiscoverActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/discover_title"
            android:parentActivityName=".MainActivityNew"
            android:theme="@style/Theme.AA_Apps_Downloader" />

        <!-- Convert already-installed apps to Play Store attribution -->
        <activity
            android:name=".ConvertActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/convert_title"
            android:parentActivityName=".MainActivityNew"
            android:theme="@style/Theme.AA_Apps_Downloader" />

        <!-- New Material You Main Activity -->
        <activity
            android:name=".MainActivityNew"
            android:screenOrientation="portrait"
            android:exported="true"
            android:theme="@style/Theme.AA_Apps_Downloader">
            <intent-filter android:label="Install Screen2Auto">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="inceptive.ru"
                    android:pathPrefix="/projects/s2a/download/" />
            </intent-filter>
        </activity>

        <!-- Removed in this standalone fork: AboutPaymentActivity, ProVersionActivity,
             EnterProCode, TransferLicense, LicenseTransferActivity. There is no PRO tier,
             no purchase, no license, and no backend to hold one. See docs/standalone.md. -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="sksa.aa.customapps.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/paths" />
        </provider>

        <!-- Shizuku Provider for Android 14+ installation support -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- PackageInstallReceiver is registered at RUNTIME, not here. Since Android 8.0,
             manifest-declared receivers never receive PACKAGE_ADDED/REMOVED/REPLACED for other
             packages — they are implicit broadcasts subject to the background execution limits,
             so this declaration looked correct upstream and silently never fired. See the class
             doc on com.legs.appsforaa.receivers.PackageInstallReceiver. -->

        <!--
          AAAD's own Android Auto surface (T-44).

          This is the OFFICIAL templated Car App Library, not the SDK the catalog apps use.
          CarStream and Fermata declare a service under
          com.google.android.gms.car.category.CATEGORY_PROJECTION and draw a full-screen Activity
          on the head unit; that SDK is not on Maven, so this fork cannot depend on it.

          The category is a compromise. Android Auto accepts NAVIGATION, POI, IOT, WEATHER, MEDIA,
          MESSAGING and CALLING — an app manager is none of those. IOT is the least wrong, and it
          is entirely possible Android Auto declines to surface this at all. See TASKS.md T-44:
          nothing here has been verified against a head unit.
        -->
        <service
            android:name="com.legs.appsforaa.car.AaadCarAppService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Android Auto reads this to decide what kind of car app this is. The official Car App
             Library docs do not list it as required, but every working templated app in the
             catalog ships one, so AAAD does too. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

    </application>





</manifest>